    "hits": 0
  },
  "gitignored": true,
  "gitignore_line": ".overwatch-index.jsonl",
  "index_line_shape": "{'uuid','window_start','window_end','cwd_slug','cwd','title','recaps[]','comms_folders[{path,tie,ambiguous}]','work_repos[{repo,commits[{sha,short,date,author,subject}]}]'}",
  "tie_counts": { "stamp": 2, "window": 3, "ambiguous": 0 },
  "commit_rows": 11,
  "verdict": "PASS"
}