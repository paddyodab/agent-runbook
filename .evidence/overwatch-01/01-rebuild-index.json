{
  "mode": "live box (this enclosing folder)",
  "command": "overwatch rebuild; overwatch rebuild",
  "index": "comms/.overwatch-index.jsonl",
  "sessions_indexed": 5,
  "titled_from_history_db": 5,
  "rebuild_first_line_count": 5,
  "rebuild_second_line_count": 5,
  "idempotent": true,
  "pointers_only_check": {
    "method": "grep of forbidden prose substrings (transcript turn text, handoff boilerplate) against the index",
